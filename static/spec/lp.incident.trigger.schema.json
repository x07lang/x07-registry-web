{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x07.io/spec/lp.incident.trigger.schema.json",
  "title": "lp.incident.trigger@0.1.0",
  "description": "Public contract for recording an incident trigger correlated to a deployment and optional rollout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_id",
    "deployment_id",
    "environment_id",
    "signal_type",
    "severity",
    "reason",
    "observations",
    "created_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "lp.incident.trigger@0.1.0" },
    "trigger_id": { "$ref": "#/$defs/id" },
    "deployment_id": { "$ref": "#/$defs/id" },
    "environment_id": { "$ref": "#/$defs/id" },
    "service_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "default": null },
    "rollout_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "default": null },
    "signal_type": { "$ref": "#/$defs/signal_type" },
    "severity": { "$ref": "#/$defs/severity" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "observations": { "type": "object", "additionalProperties": true, "default": {} },
    "request_id": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }], "default": null },
    "trace_id": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }], "default": null },
    "created_unix_ms": { "$ref": "#/$defs/unix_ms" },
    "meta": { "type": "object", "additionalProperties": true, "default": {} }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix timestamp in milliseconds (non-negative, JS-safe integer)."
    },
    "signal_type": {
      "type": "string",
      "enum": ["slo_burn", "crash_loop", "probe_fail", "manual"]
    },
    "severity": { "type": "string", "enum": ["info", "warn", "page"] }
  }
}
